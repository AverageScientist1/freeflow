{
  "name": "freeflow",
  "version": "0.11.1",
  "private": true,
  "description": "Freeflow: flow cytometry gating app",
  "main": "./out/main/index.js",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "umap-js": "^1.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "author": "Freeflow",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:desktop": "electron-vite build && playwright test -c playwright.desktop.config.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "app.freeflow.desktop",
    "productName": "Freeflow",
    "copyright": "Freeflow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.png",
      "signExecutable": false,
      "artifactName": "Freeflow-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false,
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        },
        {
          "from": "build/README-WINDOWS.txt",
          "to": "README-WINDOWS.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Freeflow",
      "artifactName": "Freeflow-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "runAfterFinish": true
    },
    "fileAssociations": [
      {
        "ext": "ffwb",
        "name": "Freeflow Workbench",
        "description": "Freeflow Workbench",
        "role": "Editor"
      },
      {
        "ext": "fcs",
        "name": "Flow cytometry data (FCS)",
        "description": "FCS file",
        "role": "Viewer"
      }
    ],
    "portable": {
      "artifactName": "Freeflow-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Freeflow-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Freeflow ${version}"
    },
    "disableAsarIntegrity": true,
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "license": "MIT"
}
